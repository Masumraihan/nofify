# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/<DATABASE_NAME>?retryWrites=true&w=majority&appName=<APP_NAME>


NODE_ENV=development
PORT=2000
IP=YOUR_LOCAL_IP

JWT_ACCESS_TOKEN_SECRET=CRYPTIC KEY
JWT_ACCESS_TOKEN_EXPIRATION_TIME=7d
JWT_REFRESH_TOKEN_SECRET=CRYPTIC KEY
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d
VERIFY_ACCOUNT_SECRET=CRYPTIC KEY
VERIFY_ACCOUNT_EXPIRATION_TIME=5m

# EMAIL CREDENTIAL
EMAIL_HOST=EMAIL
EMAIL_PORT=587
EMAIL_USER=EMAIL #BOTH EMAIL CAN BE SAME
EMAIL_PASS=GOOGLE_APP_PASSWORD

#AWS CREDENTIAL
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=


#SMS SERVICE CREDENTIAL FROM CLIENT
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_ID=
TWILIO_PHONE_NUMBER=

# GOOGLE CREDENTIAL
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URL=GOOGLE_REDIRECT_URL
GOOGLE_LOGIN_SECRET = GOOGLE_LOGIN_SECRET

# GOOGLE CREDENTIAL FOR CALENDER
GOOGLE_CLIENT_ID_CALENDER=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET_CALENDER=GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URL_CALENDER=GOOGLE_REDIRECT_URL


# PAYMENT GATEWAY CREDENTIAL
PAYMENT_GATEWAY_SECRET_KEY=STRIPE_SECRET_KEY
WEB_HOOK_URL=http://YOUR_LOCAL_IP:2000/api/v1/payment/webhook
UPDATE_SUBSCRIPTION_WEB_HOOK_URL=http://YOUR_LOCAL_IP:2000/api/v1/payment/update-subscription-webhook
SERVER_URL=CURRENT_SERVER_URL #http://192.168.40.246:2000

