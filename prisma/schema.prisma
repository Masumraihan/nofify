generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Validation {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @unique @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp        Int?
  isVerified Boolean   @default(false)
  expiresAt  DateTime? @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("validations")
}

model User {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String?
  fullName       String?
  email          String
  profilePicture String?        @default("")
  phoneNumber    String?
  fcmToken       String?        @default("")
  password       String?        @default("")
  role           String         @default("USER")
  documents      Json[]
  isDelete       Boolean        @default(false)
  isActive       Boolean        @default(true)
  stripeId       String?        @default("")
  totalCoins     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  code           String         @unique // my referral code
  referralCode   String? // referral code of the user
  validation     Validation?
  notifications  Notification[]
  subscription   Subscription[]
  payment        Payment[]
  tasks          Task[]
  files          File[]
  withdrawals    Withdrawal[]
  locationPaths  LocationPath[]
  addTasks       AddTasks[]

  @@map("users")
}

model LocationPath {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  paths     Json
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locationPaths")
}

model Package {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String
  price         Int
  coin          Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("packages")
}

model Subscription {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  packageId     String   @db.ObjectId
  package       Package  @relation(fields: [packageId], references: [id])
  transactionId String   @unique
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment?

  @@map("subscriptions")
}

model Payment {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  userId              String        @db.ObjectId
  user                User          @relation(fields: [userId], references: [id])
  amount              Int
  status              String        @default("UNPAID")
  subscriptionId      String        @unique @db.ObjectId
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  transactionId       String        @unique
  stripeTransactionId String?
  paymentData         Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("payments")
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  tasks         Task[]

  @@map("categories")
}

model SubCategory {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tasks      Task[]

  @@map("subCategories")
}

model Task {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  userId        String       @db.ObjectId
  user          User         @relation(fields: [userId], references: [id])
  title         String
  assignedTo    String
  categoryId    String       @db.ObjectId
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?      @db.ObjectId
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  date          String
  time          String
  description   String
  remainderHour Int          @default(1)
  documents     File[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignTask    AssignTask?
  addTasks      AddTasks[]

  @@map("tasks")
}

model AddTasks {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  userId     String      @db.ObjectId
  user       User        @relation(fields: [userId], references: [id])
  taskId     String      @db.ObjectId
  task       Task        @relation(fields: [taskId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  assignTask AssignTask?

  @@map("addTasks")
}

model AssignTask {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId     String   @unique @db.ObjectId
  task       Task     @relation(fields: [taskId], references: [id])
  addTaskId  String   @unique @db.ObjectId
  addTask    AddTasks @relation(fields: [addTaskId], references: [id])
  status     String   @default("PENDING")
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  coins      Coins[]
  alarm      Alarm?

  @@map("assignTask")
}

model Alarm {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  assignTaskId    String     @unique @db.ObjectId
  assignTask      AssignTask @relation(fields: [assignTaskId], references: [id])
  status          String     @default("ACTIVE")
  alarmScheduleId String     @unique
  message         String
  interval        Int
  dateTime        DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("alarms")
}

model Coins {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  assignTaskId String     @db.ObjectId
  assignTask   AssignTask @relation(fields: [assignTaskId], references: [id])
  coin         Int
  isRedeemed   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("coins")
}

model Withdrawal {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  isPaid        Boolean  @default(false)
  coin          Int
  walletAddress String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("withdrawals")
}

model File {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  url       String
  key       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Task      Task?    @relation(fields: [taskId], references: [id])
  taskId    String?  @db.ObjectId

  @@map("files")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  data      String?  @default("")
  link      String?  @default("")
  fcmToken  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model Settings {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  label   String @unique
  content String

  @@map("settings")
}
